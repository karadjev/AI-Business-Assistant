[Unit]
Description=AI Business Assistant staging health and resource sample
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ExecStart=/usr/bin/python3 /srv/aba/staging/monitor.py
TimeoutStartSec=75s
