[Unit]
Description=AI Business Assistant isolated staging PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/aba/staging/backups
TimeoutStartSec=17min
ExecStart=/usr/bin/python3 /srv/aba/staging/scheduled-backup.py
