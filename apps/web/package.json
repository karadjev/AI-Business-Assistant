{
  "name": "ai-business-assistant-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:smoke": "playwright test",
    "check:openapi": "node ../../scripts/check-openapi.mjs",
    "prebuild": "node ../../scripts/check-next-offline.cjs",
    "test:build-preflight": "node --test ../../scripts/check-next-offline.test.cjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "yaml": "2.8.2",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "@next/eslint-plugin-next": "16.4.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0"
  }
}
