# Local placeholders only. Use distinct URL-safe passwords in an ignored .env.
POSTGRES_PASSWORD=local_dev_admin_change_me
APP_DB_PASSWORD=local_dev_app_change_me
MIGRATOR_DB_PASSWORD=local_dev_migrator_change_me
API_PORT=8080
WEB_PORT=3000
LOG_LEVEL=info
# Host-native Go / Next.js commands; not used by container runtime.
# PostgreSQL host access requires infrastructure/compose.host.yml.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgresql://aba_app:local_dev_app_change_me@127.0.0.1:5432/aba?sslmode=disable
MIGRATION_DATABASE_URL=postgresql://aba_migrator:local_dev_migrator_change_me@127.0.0.1:5432/aba?sslmode=disable
API_BASE_URL=http://127.0.0.1:8080

# Dev email only. Replace key in ignored .env; keep it stable while queued mail exists.
AUTH_EMAIL_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PUBLIC_ORIGIN=http://127.0.0.1:3000
SMTP_ADDR=127.0.0.1:1025
MAILPIT_PORT=8025
SESSION_TTL=168h
SESSION_IDLE_TTL=24h
VERIFICATION_TTL=24h

# Stage 5: test-only mock, no paid requests. Keep live disabled until approved.
LLM_PROVIDER=mock
LLM_ENABLE_LIVE=false
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=2s
LLM_MAX_TOOL_CALLS=3
LLM_INPUT_TOKENS=16000
LLM_OUTPUT_TOKENS=512
LLM_DAILY_REQUESTS=40
LLM_DAILY_TOKENS=2000000
INVENTORY_FRESHNESS=24h

# Optional stage 6: generate a separate random 32-byte hex key (server only).
TELEGRAM_ENCRYPTION_KEY=
TELEGRAM_TRANSPORT=mock
TELEGRAM_RETENTION_DAYS=7

# Stage 7 Mode A: no provider selected, no external permission, budget 0 RUB.
LLM_EXTERNAL_REQUESTS_AUTHORIZED=false
LLM_KILL_SWITCH=true
LLM_BASE_URL=
LLM_ALLOWED_BASE_URLS=
LLM_PLATFORM_BUDGET_MICRORUB=0
LLM_INPUT_MICRORUB_PER_MILLION=0
LLM_OUTPUT_MICRORUB_PER_MILLION=0
LLM_MAX_PARALLEL=2
LLM_RETRIES=0
LLM_DIALOG_INPUT_TOKENS=20000
LLM_DIALOG_OUTPUT_TOKENS=5000
LLM_DIALOG_REQUESTS=30
TELEGRAM_EXTERNAL_REQUESTS_AUTHORIZED=false
TELEGRAM_SENDING_ENABLED=false
TELEGRAM_SENDING_KILL_SWITCH=true
TELEGRAM_TEST_USER_IDS=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_APPROVED_WEBHOOK_BASE_URL=

# WhatsApp offline only. Separate local 32-byte hex key; never use a real Meta token.
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_LIVE_ENABLED=false
WHATSAPP_EXTERNAL_REQUESTS_AUTHORIZED=false
WHATSAPP_MONETARY_BUDGET_RUB=0
WHATSAPP_SENDING_KILL_SWITCH=true
# Instagram durable runtime: disabled by default. Only synthetic mock in test/development.
INSTAGRAM_ENABLED=false
INSTAGRAM_LIVE_ENABLED=false
INSTAGRAM_EXTERNAL_REQUESTS_AUTHORIZED=false
INSTAGRAM_SENDING_KILL_SWITCH=true
INSTAGRAM_MONETARY_BUDGET_RUB=0
# To opt into isolated MOCK only, set ENABLED=true and supply a 32-byte hex key
# and mock:-prefixed synthetic app/verify secrets. Production/live remain rejected.
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ENCRYPTION_KEY=
INSTAGRAM_VERIFY_TOKEN=
